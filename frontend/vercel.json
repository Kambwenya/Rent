{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/publi",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*\\.(?:svg|png|jpg|jpeg|gif|ico|webp|js|css|map|json|txt|xml|webmanifest))",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
