{
  "version": 2,
  "buildCommand": "pnpm install && pnpm run build:backend && cd Frontend/Rentalls && pnpm run build",
  "outputDirectory": "Frontend/Rentalls/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}