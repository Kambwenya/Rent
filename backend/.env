# --- MongoDB Atlas ---
# Get this from Atlas -> Connect -> Drivers. Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rentalls?retryWrites=true&w=majority

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- App ---
# Public URL of your deployed frontend (used to build links in emails,
# e.g. password reset)
APP_URL=http://localhost:5173

# --- CORS ---
# Comma-separated list of origins allowed to call this API. Leave blank
# during local development (all origins allowed). Set this to your
# frontend's deployed URL in production, e.g.:
#   CORS_ORIGIN=https://rentalls.vercel.app
CORS_ORIGIN=

# --- Outbound email (optional) ---
# If left unset, emails are logged to the server console instead of being
# sent -- handy for local development. Fill these in for real delivery
# (Gmail SMTP, SendGrid, Mailgun, Postmark, etc. all work).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RentAlls <no-reply@rentalls.com>"

# --- Local dev only ---
PORT=8787
